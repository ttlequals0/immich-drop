services:
  immich-drop:
    build: .
    container_name: immich-drop
    restart: unless-stopped
    # Opt-in non-root. The image ships uid/gid 1000 (appuser). A bind-mounted
    # /data must be writable by that uid. Named volumes inherit it from the image.
    # user: "1000:1000"
    ports:
      - "8080:8080"

    environment:
      #immich drop server ip
      IMMICH_BASE_URL: https://immich.example.com/api
      IMMICH_API_KEY: ${IMMICH_API_KEY}

      PUBLIC_BASE_URL: https://drop.example.com
      #Enable/Disable Public upload page to folder
      PUBLIC_UPLOAD_PAGE_ENABLED: false
      IMMICH_ALBUM_NAME: dead-drop
      # Chunked uploads to bypass 100MB limits (e.g., Cloudflare Tunnel)
      CHUNKED_UPLOADS_ENABLED: true
      CHUNK_SIZE_MB: 95
      # Instagram / gallery-dl anti-detection
      GALLERY_DL_SLEEP_REQUEST: "10-25"
      GALLERY_DL_SLEEP: "5-15"
      GALLERY_DL_TIMEOUT: 300
      DOWNLOAD_CONCURRENCY: 1
      INSTAGRAM_YTDLP_FALLBACK: false
      # Reverse proxy: trust forwarded headers only from these addresses
      # TRUSTED_PROXY: 172.16.0.0/12
      # Require admin session or invite_token on the extension upload API
      API_UPLOAD_REQUIRE_AUTH: "false"


    volumes:
      - immich_drop_data:/data
    # Healthcheck ships in the image; override here only if you need different timings

volumes:
  immich_drop_data:
